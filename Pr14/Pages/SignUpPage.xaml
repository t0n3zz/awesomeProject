<Page x:Class="Pr14.Pages.SignUpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SignUpPage">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
            <TextBlock Text="Регистрация" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин (используется для входа):" Margin="0,5"/>
            <TextBox x:Name="TxtLogin" Padding="5"/>

            <TextBlock Text="Пароль:" Margin="0,10,0,5"/>
            <PasswordBox x:Name="TxtPassword" Padding="5"/>

            <TextBlock Text="ФИО:" Margin="0,10,0,5"/>
            <TextBox x:Name="TxtFullName" Padding="5"/>

            <TextBlock Text="Электронная почта:" Margin="0,10,0,5"/>
            <TextBox x:Name="TxtEmail" Padding="5"/>

            <Button Content="Создать аккаунт" Click="Register_Click" Height="40" Margin="0,25,0,10" 
            Background="#4CAF50" Foreground="White" FontWeight="Bold"/>

            <Button Content="Уже есть аккаунт? Войти" Click="Back_Click" Background="Transparent" 
            BorderThickness="0" Foreground="Gray" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Page>

<Page x:Class="Pr13.BasketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr13"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BasketPage">

    <Grid>
        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Ваша корзина" FontSize="24" HorizontalAlignment="Center" Margin="10"/>

            <ListBox x:Name="CartList" Grid.Row="1" Margin="10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <Image Source="{Binding ImagePath}" Width="50" Height="50"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Price, StringFormat='{}{0} руб.'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Margin="10">
                <TextBlock x:Name="TotalSumText" Text="Итого: 0 руб." FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,0,10"/>
                <UniformGrid Columns="2">
                    <Button Content="Назад" Click="Back_Click" Height="40" Margin="5"/>
                    <Button Content="Оформить заказ" Click="Order_Click" Background="Orange" FontWeight="Bold" Height="40" Margin="5"/>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

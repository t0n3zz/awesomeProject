<Page x:Class="Pr16.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="GamePage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="Black" BorderThickness="2" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="GameTitleTextBlock"
                           Text="Roguelike Game"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TurnTextBlock" Grid.Column="0" Text="Этаж: 0" FontSize="16"/>
                    <TextBlock x:Name="HpTextBlock" Grid.Column="1" Text="HP: 100/100" FontSize="16"/>
                    <TextBlock x:Name="WeaponTextBlock" Grid.Column="2" Text="Оружие: нет" FontSize="16"/>
                    <TextBlock x:Name="ArmorTextBlock" Grid.Column="3" Text="Доспех: нет" FontSize="16"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2" CornerRadius="8" Margin="0,0,0,10">
            <Grid>
                <WrapPanel x:Name="EnemiesPanel"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2" CornerRadius="8" Margin="0,0,10,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Инвентарь" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="InventoryWeaponTextBlock" Text="Оружие: нет" FontSize="16" Margin="0,0,0,5"/>
                    <TextBlock x:Name="InventoryArmorTextBlock" Text="Доспех: нет" FontSize="16"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="2" CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="Логирование" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox x:Name="LogListBox"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="NextTurnButton" Content="Следующий ход" Width="130" Height="35" Margin="5" Click="NextTurnButton_Click"/>
            <Button x:Name="AttackButton" Content="Атака" Width="100" Height="35" Margin="5" Click="AttackButton_Click"/>
            <Button x:Name="DefendButton" Content="Защита" Width="100" Height="35" Margin="5" Click="DefendButton_Click"/>
            <Button x:Name="TakeItemButton" Content="Взять предмет" Width="130" Height="35" Margin="5" Click="TakeItemButton_Click"/>
            <Button x:Name="DiscardItemButton" Content="Выбросить" Width="130" Height="35" Margin="5" Click="DiscardItemButton_Click"/>
        </StackPanel>
    </Grid>
</Page>